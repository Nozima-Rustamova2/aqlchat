ENV=development

# Postgres (mapped to 5433 locally to avoid clashing with other projects' containers on 5432)
DATABASE_URL=postgresql+psycopg://aqlchat:aqlchat@localhost:5433/aqlchat

# Redis (background jobs, Phase 2+) (mapped to 6380 locally, see note above)
REDIS_URL=redis://localhost:6380/0

# Telegram
TELEGRAM_API_BASE=https://api.telegram.org

# HuggingFace model cache. Point this at a drive with real free space -
# BGE-M3 weights are ~2.2GB. The C: drive on this dev machine has been
# observed at 0 bytes free; .hf_cache already has BGE-M3 downloaded from
# the cross-lingual model check, reused here to avoid a redundant download.
HF_HOME=.hf_cache
