ENV=development

# Postgres (mapped to 5433 locally to avoid clashing with other projects' containers on 5432)
DATABASE_URL=postgresql+psycopg://aqlchat:aqlchat@localhost:5433/aqlchat

# Redis (background jobs, Phase 2+) (mapped to 6380 locally, see note above)
REDIS_URL=redis://localhost:6380/0

# Telegram
TELEGRAM_API_BASE=https://api.telegram.org

# HuggingFace model cache. Point this at a drive with real free space -
# BGE-M3 weights are ~2.2GB. The C: drive on this dev machine has been
# observed at 0 bytes free; .hf_cache already has BGE-M3 downloaded from
# the cross-lingual model check, reused here to avoid a redundant download.
HF_HOME=.hf_cache

# Fernet key encrypting merchants.telegram_bot_token at rest (app/db/crypto.py).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored tenant bot token permanently unreadable.
TOKEN_ENCRYPTION_KEY=

# The shared platform bot (merchant-facing: self-serve onboarding, escalation
# inbox, /reply /release) - create via @BotFather, distinct from tenant bot
# tokens, which live per-merchant in the database, not env vars.
PLATFORM_BOT_TOKEN=
# Any random string; used to verify inbound webhook requests really came
# from Telegram, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
PLATFORM_WEBHOOK_SECRET=

# This server's own externally-reachable base URL (e.g. an ngrok tunnel in
# dev, your real domain in production). Used to auto-register tenant bot
# webhooks during onboarding, and as the base of the Instagram OAuth
# redirect_uri (/instagram/oauth/callback - must match the Meta app's
# configured redirect URI exactly). After this changes (tunnel restart,
# domain change), run: uv run python -m scripts.reregister_webhooks
PUBLIC_BASE_URL=

# Instagram comment-to-DM automation (app/instagram/) - from the Meta app
# (Instagram API with Instagram Login). app_secret signs webhook payloads;
# verify_token is any random string you also paste into the Meta webhook
# subscription form.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
# Pinned Graph API version - bump deliberately, changelog open.
INSTAGRAM_GRAPH_API_VERSION=v23.0
